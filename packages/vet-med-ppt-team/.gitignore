# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器临时文件
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Python
__pycache__/
*.py[cod]
*$py.class

# 临时文件
*.tmp
*.bak
*.log
.cache/

# 敏感信息（私有仓库仍建议排除）
.env
*.local
secrets.yaml

# 打包产物（v3.2.0 新增：历史 .git 有 5 个 2.5MB zip 版本，属体积浪费）
# 导出 zip 请放工作区 outputs/，不入库
*.zip
packages/vet-med-ppt-team/*.zip
__pycache__/
.pytest_cache/

# v3.17.0：坍缩产物运行时目录（route --domain 落盘，默认写在包根 .harness-runs/）
#   属运行期产物，不是包内容，不入版本库、不进第二副本
.harness-runs/

# v3.17.0：运行时 trace 日志**不再入库**
#   缘由（独立测试发现 F7）：.workbuddy/harness_trace.jsonl 此前被 git 跟踪，
#   内容含用户本机绝对路径（/Users/<用户名>/…），会随分发包泄漏本地目录结构。
#   它是运行期产物，不是包内容 —— 已在 v3.17.0 从版本库移除并加此忽略。
.workbuddy/
